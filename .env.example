# GEMINI_API_KEY: Optionnel — clé API Gemini côté serveur pour l'assistance de rédaction/mots-clés.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: URL publique de la plateforme SIMCOVA.
APP_URL="MY_APP_URL"

# SIMCOVA_DEMO_MODE: "true" pour pré-créer les comptes de présentation
# (admin@simcova.africa / AdminDemo2026! et vendeur@simcova.africa / VendeurDemo2026!)
# avec une boutique et deux produits publiés. Voir demo.cmd / DEMO.md.
SIMCOVA_DEMO_MODE=

# SIMCOVA_TOKEN_SECRET: Clé HMAC serveur pour signer les jetons de session, suivi de commande et fils de messagerie.
SIMCOVA_TOKEN_SECRET=

# SIMCOVA_KYC_ENCRYPTION_KEY: Clé AES-256 (32 octets hex ou base64) pour chiffrer au repos les pièces justificatives des vendeurs.
SIMCOVA_KYC_ENCRYPTION_KEY=

# SIMCOVA_ADMIN_PASSCODE: Mot de passe administrateur initial (sinon configuré via l'écran de premier démarrage).
SIMCOVA_ADMIN_PASSCODE=

# JUMIA_AFRICA_API_KEY: Clé marchande serveur pour l'API de paiement Jumia Africa.
JUMIA_AFRICA_API_KEY=

# JUMIA_AFRICA_WEBHOOK_SECRET: Secret HMAC pour vérifier l'authenticité des rappels système Jumia Africa.
JUMIA_AFRICA_WEBHOOK_SECRET=

# JUMIA_AFRICA_ENV: Environnement de paiement ("sandbox" ou "production").
JUMIA_AFRICA_ENV="sandbox"

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM: envoi réel des emails transactionnels
# (confirmations de commande avec lien de suivi, vérification vendeur, reset mot de passe).
# Tant que SMTP_HOST/SMTP_FROM ne sont pas définis, les emails restent dans la file visible
# dans la console Admin (mode démo). Exemple Brevo : smtp-relay.brevo.com:587.
# SMTP_SECURE="true" force le TLS implicite (automatique si port 465).
SMTP_HOST=
SMTP_PORT="587"
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIMCOVA <no-reply@simcova.africa>"
